<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">

        <!-- Send Appraisal Notification to Employee -->
        <record id="email_template_ticket_submitted" model="mail.template">
            <field name="name">Helpdesk Ticket Submitted</field>
            <field name="subject">Helpdesk Ticket Submitted</field>
            <field name="description">Template Notification for Submitted Tickets</field>
            <field name="email_from">{{ user.partner_id.email }}</field>
            <field name="email_to">{{ (','.join(ctx.get('recipients'))) }}</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket" />
            <field name="auto_delete" eval="False" />
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Ticket <t t-out="object.name"/> Submitted,</p>
                    <p>A new ticket has been submitted for your urgent attention</p>
                    <!-- <p>Here is a <a t-att-href="object.url" target="_blank">link</a> to the record.</p> -->
                    <p>Best Regards,</p>
                    <p><t t-out="user.name"/></p>
                </div>
            </field>
        </record>

    </data>

</odoo>