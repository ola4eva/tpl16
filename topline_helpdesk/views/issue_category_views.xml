<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_issue_category_tree" model="ir.ui.view">
        <field name="name">issue.category.tree</field>
        <field name="model">topline_helpdesk.issue.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="view_issue_category_form" model="ir.ui.view">
        <field name="name">issue.category.form</field>
        <field name="model">topline_helpdesk.issue.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_issue_category_search" model="ir.ui.view">
        <field name="name">issue.category.search</field>
        <field name="model">topline_helpdesk.issue.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <record id="action_issue_category" model="ir.actions.act_window">
        <field name="name">Issue Category</field>
        <field name="res_model">topline_helpdesk.issue.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_issue_category" name="Issue Category"
        parent="helpdesk.helpdesk_menu_config" action="action_issue_category" />

</odoo>
