<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <record id="group_purchase_follower" model="res.groups">
            <field name="name">Purchase Follower</field>
            <field name="category_id" ref="base.module_category_inventory_purchase" />
            <field name="users" eval="[(4, ref('base.user_admin'))]" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>


        <record id="purchase_order_follower_rule" model="ir.rule">
            <field name="name">Purchase Order Follower Rule</field>
            <field name="model_id" ref="purchase.model_purchase_order" />
            <field name="domain_force">[('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('topline_purchase.group_purchase_follower'))]" />
        </record>
    </data>

</odoo>